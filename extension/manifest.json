{
  "manifest_version": 3,
  "name": "M-에듀파인 연결",
  "version": "0.1.0",
  "key": "",
  "description": "사용자가 선택한 실제 K-에듀파인 탭을 Windows 키보드 클라이언트에 연결합니다. 비공식 현장검증용.",
  "permissions": ["nativeMessaging", "scripting", "activeTab", "webNavigation"],
  "host_permissions": ["https://klef.sen.go.kr/*", "https://sen.eduptl.kr/*"],
  "optional_host_permissions": ["https://*.go.kr/*", "https://*.eduptl.kr/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_popup": "popup.html", "default_title": "M-에듀파인 · 이 탭 연결"},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'"}
}
