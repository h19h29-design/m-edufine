<Window x:Class="MEdufine.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:MEdufine"
 Title="M-에듀파인 · 키보드 업무 클라이언트"
 Width="1440" Height="900" MinWidth="1100" MinHeight="720" WindowStartupLocation="CenterScreen"
 Background="#071B51" Foreground="#E5EDFF" FontFamily="Malgun Gothic" FontSize="18"
 PreviewKeyDown="OnKeys" Closing="OnClosing" UseLayoutRounding="True" SnapsToDevicePixels="True">
 <Window.Resources>
  <SolidColorBrush x:Key="Ink" Color="#E5EDFF"/><SolidColorBrush x:Key="Panel" Color="#0C245F"/>
  <Style TargetType="Button"><Setter Property="Background" Value="#173C83"/><Setter Property="Foreground" Value="#E5EDFF"/>
   <Setter Property="BorderBrush" Value="#6A91C3"/><Setter Property="Padding" Value="10,6"/><Setter Property="Margin" Value="3"/>
   <Setter Property="FontSize" Value="14"/><Setter Property="MinHeight" Value="34"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#031338"/><Setter Property="Foreground" Value="#F0F5FF"/>
   <Setter Property="CaretBrush" Value="#84EAD8"/><Setter Property="BorderBrush" Value="#6A91C3"/><Setter Property="Padding" Value="9,6"/></Style>
  <Style TargetType="ListBox"><Setter Property="Background" Value="#0C245F"/><Setter Property="Foreground" Value="#E5EDFF"/>
   <Setter Property="BorderThickness" Value="0"/></Style>
  <Style TargetType="DataGrid"><Setter Property="Background" Value="#0A2057"/><Setter Property="Foreground" Value="#E5EDFF"/>
   <Setter Property="RowBackground" Value="#0A2057"/><Setter Property="AlternatingRowBackground" Value="#102A65"/>
   <Setter Property="BorderThickness" Value="0"/><Setter Property="GridLinesVisibility" Value="Horizontal"/>
   <Setter Property="HorizontalGridLinesBrush" Value="#25447A"/><Setter Property="HeadersVisibility" Value="Column"/>
   <Setter Property="RowHeight" Value="44"/><Setter Property="ColumnHeaderHeight" Value="42"/>
   <Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/>
   <Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="CanUserReorderColumns" Value="False"/>
   <Setter Property="SelectionMode" Value="Single"/><Setter Property="SelectionUnit" Value="FullRow"/>
   <Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="FontSize" Value="18"/>
   <Setter Property="CanUserSortColumns" Value="False"/></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#183A7C"/><Setter Property="Foreground" Value="#C4D9F3"/>
   <Setter Property="Padding" Value="10,6"/><Setter Property="FontSize" Value="15"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="8,6"/>
   <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#8CE3D6"/>
    <Setter Property="Foreground" Value="#071B51"/></Trigger></Style.Triggers></Style>
  <Style TargetType="TreeView"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Foreground" Value="#E5EDFF"/></Style>
  <Style x:Key="MenuNodeStyle" TargetType="TreeViewItem">
   <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
   <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
   <Setter Property="Padding" Value="4,5"/><Setter Property="Margin" Value="0,1"/>
   <Setter Property="FontSize" Value="18"/><Setter Property="Foreground" Value="#E5EDFF"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Style.Triggers>
    <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#8CE3D6"/><Setter Property="Foreground" Value="#071B51"/>
     <Setter Property="FontWeight" Value="Bold"/></Trigger>
   </Style.Triggers>
  </Style>
  <HierarchicalDataTemplate DataType="{x:Type local:MenuNode}" ItemsSource="{Binding Children}">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/>
    <TextBlock Grid.Column="1" Text="{Binding Badge}" Margin="8,0,2,0" FontSize="13" Foreground="#8CE3D6"/>
   </Grid>
  </HierarchicalDataTemplate>
 </Window.Resources>
 <Grid Margin="18,14">
  <Grid.RowDefinitions><RowDefinition Height="74"/><RowDefinition Height="52"/><RowDefinition Height="*"/><RowDefinition Height="96"/></Grid.RowDefinitions>

  <Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock FontFamily="Consolas" FontSize="30" FontWeight="Bold" Foreground="#8CE3D6" Text="M-EDUFINE"/>
    <TextBlock FontSize="14" Foreground="#BCD0F0" Text="실제 로그인 세션 그대로 · 키보드로 업무 메뉴를 따라갑니다."/></StackPanel>
   <StackPanel Grid.Column="1" HorizontalAlignment="Right">
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
     <Border Background="#14331F" BorderBrush="#3FBF7F" BorderThickness="1" CornerRadius="3" Padding="8,3" Margin="0,0,8,0">
      <TextBlock x:Name="ReadOnlyChip" Text="읽기 전용" FontSize="14" Foreground="#8CE3D6"/></Border>
     <TextBlock x:Name="ConnectionText" Text="○ 브라우저 연결 대기" FontSize="16" Foreground="#FFE18E"
      MaxWidth="430" TextTrimming="CharacterEllipsis" TextAlignment="Right"/></StackPanel>
     <TextBlock x:Name="VersionText" Margin="0,6,0,0" FontSize="12.5" Foreground="#BCD0F0" HorizontalAlignment="Right"
      Text="v0.3.0 PREVIEW · 비공식" AutomationProperties.Name="v0.3.0 preview, unofficial"/></StackPanel>
  </Grid>

  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock Text="현재 경로" VerticalAlignment="Center" Foreground="#8CE3D6" Margin="0,0,10,0"/>
   <TextBlock x:Name="PathText" Grid.Column="1" VerticalAlignment="Center" FontSize="17" TextTrimming="CharacterEllipsis"
    Text="연결 대기 · F5로 현재 화면을 읽습니다." AutomationProperties.Name="현재 업무 경로"/>
   <TextBox x:Name="SearchBox" Grid.Column="2" Width="260" Margin="10,7,6,7" VerticalContentAlignment="Center"
    TextChanged="SearchChanged" AutomationProperties.Name="현재 읽은 메뉴와 항목 찾기"/>
   <Button Grid.Column="3" x:Name="ReadButton" Content="F5  다시 읽기" Click="ReadClicked" Margin="0,7,0,7"/>
  </Grid>

  <Grid Grid.Row="2" Margin="0,10,0,0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

   <Border BorderBrush="#668DC4" BorderThickness="1" Background="#0C245F">
    <DockPanel>
     <StackPanel DockPanel.Dock="Top" Margin="14,12,12,8">
      <TextBlock Text="업무 메뉴" FontWeight="Bold" FontSize="19" Foreground="#8CE3D6"/>
      <TextBlock Text="↑↓ 이동 · → 펼침 · Enter 폴더/실행" FontSize="12.5" Margin="0,5,0,0" Foreground="#BCD0F0"/></StackPanel>
     <StackPanel DockPanel.Dock="Bottom" Margin="13,10,10,12">
      <TextBlock Text="● 현재 화면 · 숫자 = 하위 메뉴 수" FontSize="12.5" Foreground="#8CE3D6"/>
      <TextBlock Margin="0,6,0,0" FontSize="12.5" Foreground="#BCD0F0" TextWrapping="Wrap"
       Text="메뉴는 실제 화면에서 읽은 구조입니다. 보이지 않는 메뉴는 F4 원본 웹에서 확인하세요."/></StackPanel>
     <TreeView x:Name="MenuTree" Margin="6,0,6,0" ItemContainerStyle="{StaticResource MenuNodeStyle}"
      VirtualizingPanel.IsVirtualizing="False" SelectedItemChanged="MenuSelected" AutomationProperties.Name="업무 메뉴 트리"/>
    </DockPanel>
   </Border>

   <Border Grid.Column="2" BorderBrush="#668DC4" BorderThickness="1" Background="#0A2057">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel Margin="16,10,16,6">
      <TextBlock x:Name="PageTitle" Text="업무 메뉴를 읽어 주세요" FontSize="20" FontWeight="Bold" TextWrapping="Wrap"/>
      <TextBlock x:Name="PageMeta" Text="로그인 화면을 복제하지 않습니다. 인증은 실제 Chrome 탭에서 합니다." FontSize="13" Margin="0,5,0,0" Foreground="#BCD0F0" TextWrapping="Wrap"/></StackPanel>

     <Grid Grid.Row="1">
      <DataGrid x:Name="ContentGrid" Margin="8,0" SelectionChanged="RowSelected"
       AutomationProperties.Name="선택한 메뉴의 하위 메뉴와 실제 항목">
       <DataGrid.Columns>
        <DataGridTextColumn Header="구분" Binding="{Binding Kind}" Width="110"/>
        <DataGridTextColumn Header="이름" Binding="{Binding Label}" Width="*"/>
        <DataGridTextColumn Header="현재 값" Binding="{Binding Value}" Width="*"/></DataGrid.Columns>
      </DataGrid>
      <Grid x:Name="TablesPanel" Visibility="Collapsed" Margin="12,0">
       <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
       <ComboBox x:Name="TablePicker" Margin="0,0,0,10" SelectionChanged="TableChanged" FontSize="17"
        AutomationProperties.Name="현재 화면의 표 선택"/>
       <DataGrid x:Name="TableGrid" Grid.Row="1" AutoGenerateColumns="True" CanUserResizeColumns="True"
        HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="현재 화면의 표"/>
      </Grid>
      <StackPanel x:Name="WelcomePanel" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="680" Margin="35">
       <TextBlock Text="웹은 그대로. 조작은 키보드로." FontSize="25" Foreground="#8CE3D6" FontWeight="Bold" TextWrapping="Wrap"/>
       <TextBlock Margin="0,18,0,0" FontSize="17" LineHeight="30" TextWrapping="Wrap"
        Text="1  F1에서 최초 연결 설정을 확인합니다.&#10;2  F9로 업무 사이트를 열고 평소처럼 로그인합니다.&#10;3  확장 버튼에서 ‘이 탭 연결’을 누릅니다.&#10;4  F5로 읽고, 왼쪽 메뉴에서 Enter로 따라갑니다."/>
       <TextBlock Margin="0,20,0,0" FontSize="14" Foreground="#FFE18E" TextWrapping="Wrap"
        Text="처음에는 읽기 전용입니다. 저장·등록은 실제 서버에 영향을 줄 수 있으므로 실행 전 내용을 확인하세요."/>
      </StackPanel>
     </Grid>

     <Border Grid.Row="2" Background="#112E6A" Padding="14,8" Margin="0,8,0,0">
      <TextBlock x:Name="DetailText" FontSize="13.5" Foreground="#D2E2FA" TextWrapping="Wrap"
       Text="Enter 폴더 펼치기/실행 · F2 입력 · F4 원본 웹 · F6 표 · F7 읽기 전용"/></Border>
    </Grid>
   </Border>
  </Grid>

  <StackPanel Grid.Row="3" Margin="0,10,0,0">
   <TextBlock x:Name="StatusText" FontSize="14" Foreground="#FFE18E" TextWrapping="Wrap"
    Text="연결 대기 · 업무 내용은 메모리에만 표시합니다. 인증서·비밀번호는 읽지 않습니다."/>
   <WrapPanel Margin="-3,5,0,0">
    <Button Content="F1 도움말" Click="HelpClicked"/><Button Content="F2 입력" Click="EditClicked"/>
    <Button Content="F4 원본 웹" Click="WebClicked"/><Button Content="F5 다시 읽기" Click="ReadClicked"/>
    <Button Content="F6 표" Click="TablesClicked"/><Button x:Name="PermissionButton" Content="F7 읽기 전용" Click="TogglePermission"/>
    <Button Content="F8 저장 찾기" Click="SaveClicked"/><Button Content="F9 로그인" Click="LoginClicked"/>
    <Button Content="Ctrl+F4 탭 전환" Click="TabsClicked"/><Button Content="F12 설정" Click="SettingsClicked"/>
   </WrapPanel>
  </StackPanel>
 </Grid>
</Window>
